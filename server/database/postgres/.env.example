# PostgreSQL (external database) — copy/paste env
# The server reads these in server/config.js. Prefer a single DATABASE_URL
# (what Neon / Supabase / Railway / Render give you) over discrete parts.

# Switch the driver. Defaults to mysql; set to postgres to use this folder.
DB_DRIVER=postgres

# Option A — hosted URL (recommended). Keep the password URL-encoded.
# Neon example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/zavora?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zavora?sslmode=require

# Option B — discrete parts (used only when DATABASE_URL is empty).
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=zavora

# Force SSL even without sslmode=require (auto-enabled for neon.tech /
# supabase.co / render.com hosts). Set true for any other hosted PG.
# DB_SSL=true
